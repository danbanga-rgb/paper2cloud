# Supabase (project settings → API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=          # server only, never shipped to the browser

# Extraction provider — one of: anthropic | openai | google | mock
EXTRACTION_PROVIDER=anthropic
ANTHROPIC_API_KEY=
EXTRACTION_MODEL=claude-opus-5      # vision-capable Claude model id
EXTRACTION_EFFORT=                  # optional: low | medium | high | xhigh | max (unset = model default)
EXTRACTION_PROMPT_VERSION=v1
EXTRACTION_DAILY_SPEND_ALERT_USD=5

# Web Push (generate with: npx web-push generate-vapid-keys)
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:owner@example.com

# QuickBooks leg (Phase 3) — the existing Timesheet App qbXML/Web Connector service
QB_SYNC_SERVICE_URL=                # endpoint that consumes qb_sync rows
QB_SYNC_SHARED_SECRET=
